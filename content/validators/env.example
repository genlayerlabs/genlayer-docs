# GenLayer Node Release Configuration
# Copy this file to .env and configure for your deployment

# =============================================================================
# WebDriver Configuration (required for GenVM)
# =============================================================================
WEBDRIVER_PORT=4444

# =============================================================================
# Node Service Configuration (optional - use node profile)
# =============================================================================
# Docker image version
NODE_VERSION=latest

# Keystore password (unlocks the pre-imported validator wallet). Required — the
# stack refuses to start without it. Choose your own; never reuse an example
# value. It reaches the node as an environment variable, not a command-line
# argument. See README section 4 for reading it in without echo.
NODE_PASSWORD=

# Path to node configuration file
NODE_CONFIG_PATH=./configs/node/config.yaml

# Path to the trusted protocol manifest of your network
NODE_MANIFEST_PATH=./configs/node/protocol-manifest.json

# Path to node data directory (for persistence)
NODE_DATA_PATH=./data

# Port mappings
NODE_RPC_PORT=9151
NODE_OPS_PORT=9153

# LLM API Keys (required for GenVM LLM module)
OPENROUTERKEY=
HEURISTKEY=
ANTHROPICKEY=
XAIKEY=
GEMINIKEY=
ATOMAKEY=

# Optional logging level override
GENLAYERNODE_LOGGING_LEVEL=INFO

# API key of the GenLayer Chain RPC provider, for both the RPC and the
# WebSocket endpoint of the node config. Optional: leave it empty when the
# endpoints need no key. Put the key only here, never in the endpoint URLs of
# the config: a key in a URL ends up in logs and error texts.
GENLAYERNODE_ROLLUP_GENLAYERCHAINRPCKEY=

# Operator bearer token for the ops server's POST /snapshot route. When
# unset, the route is default-deny (every caller gets 401). Set this to
# enable operator-driven snapshot tooling from outside the node container.
# Generate with: openssl rand -hex 32
GENLAYERNODE_NODE_OPERATOR_TOKEN=

# =============================================================================
# Monitoring Configuration (optional - use monitoring profile)
# =============================================================================

# Where Alloy pushes metrics and logs. All six values are REQUIRED when the
# monitoring profile is up — the alloy container stops with a clear message
# when any is missing. There are no defaults on purpose: an endpoint default
# sends your data to somebody else's tenant, and a credential default gives
# everybody the same key.
#
# Examples:
#   Your own local stack:
#     CENTRAL_MONITORING_URL=http://localhost:9090/api/v1/write
#     CENTRAL_LOKI_URL=http://localhost:3100/loki/api/v1/push
#   A Grafana Cloud tenant (values from your Grafana Cloud stack page):
#     CENTRAL_MONITORING_URL=https://<your-prometheus-endpoint>/api/prom/push
#     CENTRAL_LOKI_URL=https://<your-loki-endpoint>/loki/api/v1/push
#
# A receiver without authentication still needs the username/password set —
# any placeholder value satisfies the start check and is ignored by the
# receiver.
CENTRAL_MONITORING_URL=
CENTRAL_LOKI_URL=

# Metrics (Prometheus) credentials
CENTRAL_MONITORING_USERNAME=
CENTRAL_MONITORING_PASSWORD=
# Logs (Loki) credentials
CENTRAL_LOKI_USERNAME=
CENTRAL_LOKI_PASSWORD=

# =============================================================================
# Single Node Configuration
# =============================================================================
# Use these variables for monitoring a single node

# Node identification
NODE_ID=validator-001
VALIDATOR_NAME=MyValidator
# Network label for recovery logs and alert routing; use the deployed network.
# Leave empty for an unknown label, rather than guessing a production network.
NETWORK_NAME=

# Node metrics endpoint (optional)
# Endpoint where the node exposes its Prometheus metrics
# Default: host.docker.internal:9153
NODE_METRICS_ENDPOINT=host.docker.internal:9153

# =============================================================================
# Multi-Node Configuration
# =============================================================================
# Alternative to single node config: provide a JSON array of targets
# When SCRAPE_TARGETS_JSON is set, it overrides NODE_ID, VALIDATOR_NAME, and NODE_METRICS_ENDPOINT
#
# Format: JSON array of target objects with required fields:
#   - __address__: "host:port" of the metrics endpoint
#   - instance: unique identifier (e.g., node address)
#   - validator_name: human-readable name
#
# Example for multiple nodes:
# SCRAPE_TARGETS_JSON=[{"__address__":"host.docker.internal:9250","instance":"0x...","validator_name":"node-1"},{"__address__":"host.docker.internal:9251","instance":"0x...","validator_name":"node-2"}]
#
# To generate for local nodes, use: ./generate-dev-targets.sh
# SCRAPE_TARGETS_JSON=

# =============================================================================
# Log Collection Configuration
# =============================================================================
# Local log directory (on host machine)
# Path where GenLayer node(s) write their log files
# Single node: ./data/node/logs
# Multi-node: ./data/node/default (parent directory containing all node subdirs)
NODE_LOGS_PATH=./data/node/logs

# Log file pattern (inside container, mapped from NODE_LOGS_PATH)
# Single node: /var/log/genlayer/node.log
# Multi-node: /var/log/genlayer/*/logs/node.log
# Default: /var/log/genlayer/node*.log (matches both patterns)
LOG_FILE_PATTERN=/var/log/genlayer/node*.log

# Metrics scraping intervals (optional)
# How often to scrape metrics from the node
# Default: 15s for node metrics, 10s timeout
METRICS_SCRAPE_INTERVAL=15s
METRICS_SCRAPE_TIMEOUT=10s

# Alloy internal health monitoring interval (optional)
# How often Alloy checks its own internal health metrics
# These metrics are not forwarded, only used for local debugging
# Default: 60s
ALLOY_SELF_MONITORING_INTERVAL=60s

# Loki log batching configuration (optional)
# Controls how logs are batched before sending to central Loki
# Default: 1MiB batch size, 1s wait time
LOKI_BATCH_SIZE=1MiB
LOKI_BATCH_WAIT=1s

# =============================================================================
# Deployment Instructions
# =============================================================================
#
# 1. Basic deployment (WebDriver only):
#    docker compose up -d
#
# 2. Node deployment (WebDriver + Node):
#    Configure node settings above, then:
#    docker compose --profile node up -d
#
# 3. Node with monitoring (WebDriver + Node + Alloy):
#    Configure node and monitoring settings, then:
#    docker compose --profile node --profile monitoring up -d
#
# 4. Monitoring only (WebDriver + Alloy):
#    Configure monitoring settings, then:
#    docker compose --profile monitoring up -d
#
# 5. Check status:
#    docker compose ps
#    docker compose logs genlayer-node
#    docker compose logs alloy
#
# =============================================================================
# Configuration Notes
# =============================================================================
#
# - Grafana Alloy handles both metrics and logs in a single service
# - To customize monitoring, edit alloy-config.river
# - To filter metrics (reduce bandwidth), uncomment the filtering rule in alloy-config.river
# - Ensure firewall allows outbound connections to monitoring server (port 8180)
#

# Keep health checks but disable automatic container-local recycling when false.
HEALTHCHECK_AUTO_RESTART=true
